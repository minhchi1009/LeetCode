class Solution {
public:
    vector<bool> kidsWithCandies(vector<int>& candies, int extraCandies) {
        int max = candies[0];
        for(int i=1;i<size(candies);i++){
            if(candies[i]>max) max = candies[i];
        }
        vector<bool> result(size(candies));
        for(int i=0;i<size(candies);i++){
            if(candies[i]+extraCandies >= max) result[i] = true;
            else result[i] = false;
        }
        return result;
    }
};
